{
  "name": "pendulum-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "overrides": {
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "scripts": {
    "check": "node scripts/check-static-assets.mjs && node scripts/test-lhci-windows-recovery.cjs && node scripts/bundle-hero.mjs --check",
    "audit": "npm audit --audit-level=high",
    "build:ko": "node scripts/build-ko-page.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:fonts": "python scripts/subset-pretendard.py",
    "assets:hero-fallback": "node scripts/capture-hero-fallback.mjs",
    "assets:og-card": "node scripts/generate-og-card.mjs",
    "assets:simulator-preview": "node scripts/capture-simulator-assets.mjs",
    "build:hero": "node scripts/bundle-hero.mjs",
    "prepare:site": "node scripts/prepare-site.mjs",
    "sync:changelog": "node scripts/sync-changelog-highlights.mjs",
    "sync:copy": "node scripts/sync-copy-counts.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "lighthouse:lhci": "node scripts/run-lhci.mjs",
    "test": "playwright test",
    "smoke": "playwright test tests/landing-smoke.spec.ts --project=chromium",
    "smoke:ci": "playwright test tests/landing-smoke.spec.ts --project=chromium --workers=1 --reporter=list && playwright test tests/landing-smoke.spec.ts --project=mobile-chrome --workers=1 --reporter=list && playwright test tests/landing-smoke.spec.ts --project=firefox --workers=1 --reporter=list && playwright test tests/landing-smoke.spec.ts --project=webkit --workers=1 --reporter=list"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.60.0",
    "esbuild": "^0.28.1",
    "pretendard": "^1.3.9",
    "three": "^0.185.1",
    "wrangler": "^4.110.0"
  }
}
